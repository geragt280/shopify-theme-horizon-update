# ==========================================
# Shopify Theme .gitignore
# ==========================================

# Shopify CLI & Environment
.shopify/
.shopify-cli/
.theme-check.cache/
.env
.env.*
!.env.example
config.yml

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors & IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary Files & Logs
*.log
*.tmp
*.temp
.cache/
tmp/
scratch/
