    "brand_showcase_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div id=\"shop-by-brand\" class=\"brand-showcase-section\">\n  <div class=\"brand-showcase-header\">\n    <h2>Shop by Brand</h2>\n    <p>Authentic designer collections from Pakistan's most loved fashion labels</p>\n  </div>\n  <div class=\"brand-grid\">\n    <a href=\"/collections/asim-jofa\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Luxury Apparel</span>\n      <span class=\"brand-card__name\">Asim Jofa</span>\n      <span class=\"brand-card__desc\">Stitched &amp; Unstitched</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n    <a href=\"/collections/baroque\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Chantelle &amp; Swiss</span>\n      <span class=\"brand-card__name\">Baroque</span>\n      <span class=\"brand-card__desc\">Festive &amp; Formals</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n    <a href=\"/collections/sana-safinaz\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Contemporary Style</span>\n      <span class=\"brand-card__name\">Sana Safinaz</span>\n      <span class=\"brand-card__desc\">Muzlin &amp; Luxury Silk</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n    <a href=\"/collections/stylo\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Footwear &amp; Bags</span>\n      <span class=\"brand-card__name\">Stylo</span>\n      <span class=\"brand-card__desc\">Khussas, Heels &amp; Flats</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n    <a href=\"/collections/maria-b\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Couture &amp; Linen</span>\n      <span class=\"brand-card__name\">Maria.B</span>\n      <span class=\"brand-card__desc\">Bridal &amp; Luxury Pret</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n    <a href=\"/collections/insignia\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Luxury Footwear</span>\n      <span class=\"brand-card__name\">Insignia</span>\n      <span class=\"brand-card__desc\">Bespoke Shoes &amp; Clutches</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n    <a href=\"/collections/sapphire\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Everyday Comfort</span>\n      <span class=\"brand-card__name\">Sapphire</span>\n      <span class=\"brand-card__desc\">Daily Pret &amp; West</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n    <a href=\"/collections/khaadi\" class=\"brand-card\">\n      <span class=\"brand-card__tag\">Heritage Weaves</span>\n      <span class=\"brand-card__name\">Khaadi</span>\n      <span class=\"brand-card__desc\">Prints, Solids &amp; Shawls</span>\n      <span class=\"brand-card__arrow\">View Collection →</span>\n    </a>\n  </div>\n</div>",
