    "testimonials_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"testimonials-section\">\n  <h2 class=\"testimonials-heading\">What Our Customers Say</h2>\n  <div class=\"testimonials-grid\">\n    <div class=\"testimonial-card\">\n      <div class=\"stars\">★★★★★</div>\n      <p class=\"testimonial-quote\">\"The quality is outstanding! I've received so many compliments. Carefree Shopping is now my go-to for every occasion.\"</p>\n      <div class=\"testimonial-author\">\n        <span class=\"author-name\">Sarah M.</span>\n        <span class=\"author-detail\">Verified Buyer</span>\n      </div>\n    </div>\n    <div class=\"testimonial-card\">\n      <div class=\"stars\">★★★★★</div>\n      <p class=\"testimonial-quote\">\"Fast shipping, beautiful packaging, and the clothes fit perfectly. It truly is carefree shopping — no stress, just style!\"</p>\n      <div class=\"testimonial-author\">\n        <span class=\"author-name\">Amira K.</span>\n        <span class=\"author-detail\">Verified Buyer</span>\n      </div>\n    </div>\n    <div class=\"testimonial-card\">\n      <div class=\"stars\">★★★★★</div>\n      <p class=\"testimonial-quote\">\"I love how comfortable everything is. You can tell the fabrics are chosen with care. Already planning my next order!\"</p>\n      <div class=\"testimonial-author\">\n        <span class=\"author-name\">Jessica L.</span>\n        <span class=\"author-detail\">Verified Buyer</span>\n      </div>\n    </div>\n  </div>\n</div>",
        "background_color": "#ede7df",
