{%- doc -%}
  Category Feature Cards Showcase
  Displays modern, high-converting category cards with dynamic collection binding.
  Auto-rotates collection tags and images every 4 seconds (with cross-fade and active tag highlight).
{%- enddoc -%}

<style>
  .cat-feature-cards-section {
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .cat-feature-cards__container {
    margin-inline: auto;
    padding-inline: var(--section-padding-inline, 1.5rem);
    max-width: 100%;
    box-sizing: border-box;
  }

  .cat-feature-cards__container.page-width {
    max-width: 1360px;
  }

  .cat-feature-cards__header {
    margin-bottom: 2rem;
  }

  .cat-feature-cards__header--left {
    text-align: left;
  }

  .cat-feature-cards__header--center {
    text-align: center;
  }

  .cat-feature-cards__title {
    font-family: var(--font-heading--family, serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-warm-fg, #2C2420);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .cat-feature-cards__subtitle {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.9375rem;
    color: var(--color-warm-sec, #6B5E54);
    margin: 0;
  }

  /* Grid Layout */
  .cat-feature-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  /* Card Item */
  .cat-feature-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), 
                box-shadow 0.35s cubic-bezier(0.25, 1, 0.5, 1), 
                border-color 0.35s ease;
    overflow: hidden;
    box-sizing: border-box;
  }

  .cat-feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(44, 36, 32, 0.09);
    border-color: #D6CBC0;
  }

  .cat-feature-card__overlay-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-indent: -9999px;
  }

  /* Zone 1: Header (Title + Subtitle + Circular Button) */
  .cat-feature-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
    position: relative;
    z-index: 2;
  }

  .cat-feature-card__title-group {
    flex: 1;
  }

  .cat-feature-card__name {
    font-family: var(--font-heading--family, serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.25;
    margin: 0 0 4px 0;
    letter-spacing: -0.01em;
  }

  .cat-feature-card__tagline {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8125rem;
    color: #6B7280;
    margin: 0;
    line-height: 1.35;
  }

  .cat-feature-card__btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #1E2530;
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 2;
    text-decoration: none;
  }

  .cat-feature-card:hover .cat-feature-card__btn {
    background-color: var(--color-warm-accent, #8B6F4E);
    transform: translateX(3px);
  }

  /* Zone 2: Pills / Tags (Interactive & Rotatable) */
  .cat-feature-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    position: relative;
    z-index: 3;
  }

  .cat-feature-card__pill {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 100px;
    background-color: #F3F4F6;
    color: #374151;
    border: 1px solid #E5E7EB;
    white-space: nowrap;
    line-height: 1.2;
    cursor: pointer;
    transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease, transform 0.2s ease;
    user-select: none;
    outline: none;
    text-decoration: none;
  }

  .cat-feature-card__pill:hover {
    border-color: #CBD5E1;
    transform: translateY(-1px);
  }

  /* Active / Highlighted Pill (Dark Background) */
  .cat-feature-card__pill--highlight {
    background-color: #1E2530 !important;
    color: #FFFFFF !important;
    border-color: #1E2530 !important;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(30, 37, 48, 0.22);
  }

  /* Zone 3: Featured Image Container with Smooth Cross-Fade */
  .cat-feature-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    background-color: #F8F9FA;
    margin-bottom: 18px;
    z-index: 1;
  }

  .cat-feature-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    transform: scale(1);
    will-change: opacity, transform;
  }

  .cat-feature-card__img.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .cat-feature-card:hover .cat-feature-card__img.is-active {
    transform: scale(1.06);
  }

  .cat-feature-card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease;
  }

  .cat-feature-card__placeholder.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Zone 4: Bottom Meta & Social Proof */
  .cat-feature-card__bottom {
    padding-top: 2px;
    position: relative;
    z-index: 2;
  }

  .cat-feature-card__highlight-title {
    font-family: var(--font-heading--family, serif);
    font-size: 1rem;
    font-weight: 700;
    color: #1A1A1A;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .cat-feature-card__metrics {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.75rem;
    color: #6B7280;
    font-weight: 500;
  }

  .cat-feature-card__metric {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .cat-dot--green {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10B981;
    display: inline-block;
  }

  .cat-icon-heart {
    display: inline-block;
    flex-shrink: 0;
  }

  .cat-icon-bolt {
    display: inline-block;
    flex-shrink: 0;
  }

  .cat-feature-card__metric--trending {
    color: #D946EF;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  /* Responsive Breakpoints */
  @media screen and (max-width: 989px) {
    .cat-feature-cards__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
  }

  @media screen and (max-width: 640px) {
    .cat-feature-cards__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .cat-feature-card {
      padding: 18px;
      border-radius: 16px;
    }

    .cat-feature-card__name {
      font-size: 1.25rem;
    }
  }
</style>

<div
  class="cat-feature-cards-section"
  style="background-color: {{ section.settings.background_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="cat-feature-cards__container {{ section.settings.section_width }}">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="cat-feature-cards__header cat-feature-cards__header--{{ section.settings.heading_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="cat-feature-cards__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="cat-feature-cards__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="cat-feature-cards__grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_title = block.settings.title
          if card_title == blank
            assign card_title = 'Category ' | append: forloop.index
          endif

          # Slot 1
          assign coll_1 = block.settings.collection_1
          if coll_1 == blank
            assign coll_1 = block.settings.collection
          endif
          assign label_1 = block.settings.pill_1 | default: coll_1.title | default: 'Pure Lawn'
          assign url_1 = coll_1.url | default: '#'
          assign img_1 = block.settings.image_1 | default: coll_1.image | default: coll_1.products.first.featured_image

          # Slot 2
          assign coll_2 = block.settings.collection_2
          assign label_2 = block.settings.pill_2
          if label_2 == blank and coll_2 != blank
            assign label_2 = coll_2.title
          endif
          assign url_2 = coll_2.url | default: '#'
          assign img_2 = block.settings.image_2 | default: coll_2.image | default: coll_2.products.first.featured_image

          # Slot 3
          assign coll_3 = block.settings.collection_3
          assign label_3 = block.settings.pill_3
          if label_3 == blank and coll_3 != blank
            assign label_3 = coll_3.title
          endif
          assign url_3 = coll_3.url | default: '#'
          assign img_3 = block.settings.image_3 | default: coll_3.image | default: coll_3.products.first.featured_image

          # Count available slides
          assign slide_count = 1
          if label_2 != blank or img_2 != blank
            assign slide_count = 2
          endif
          if label_3 != blank or img_3 != blank
            assign slide_count = 3
          endif
        %}

        <div
          class="cat-feature-card"
          data-cat-card
          data-slide-count="{{ slide_count }}"
          data-interval="{{ section.settings.autoplay_interval | default: 4 }}"
          {{ block.shopify_attributes }}
        >
          <a href="{{ url_1 }}" class="cat-feature-card__overlay-link" data-card-link aria-label="{{ card_title }}">
            {{ card_title }}
          </a>

          <!-- Top: Title, Subtitle & Circular Arrow Button -->
          <div class="cat-feature-card__top">
            <div class="cat-feature-card__title-group">
              <h3 class="cat-feature-card__name">{{ card_title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p class="cat-feature-card__tagline">{{ block.settings.subtitle }}</p>
              {% endif %}
            </div>

            <a href="{{ url_1 }}" class="cat-feature-card__btn" data-arrow-btn aria-label="Explore {{ card_title }}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <!-- Feature / Spec Pills (Interactive Carousel Controls) -->
          <div class="cat-feature-card__pills">
            {% if label_1 != blank %}
              <button
                type="button"
                class="cat-feature-card__pill cat-feature-card__pill--highlight"
                data-pill-index="0"
                data-url="{{ url_1 }}"
              >
                {{ label_1 }}
              </button>
            {% endif %}

            {% if label_2 != blank %}
              <button
                type="button"
                class="cat-feature-card__pill"
                data-pill-index="1"
                data-url="{{ url_2 }}"
              >
                {{ label_2 }}
              </button>
            {% endif %}

            {% if label_3 != blank %}
              <button
                type="button"
                class="cat-feature-card__pill"
                data-pill-index="2"
                data-url="{{ url_3 }}"
              >
                {{ label_3 }}
              </button>
            {% endif %}
          </div>

          <!-- Central Image Stack with Smooth Fade -->
          <div class="cat-feature-card__media">
            {% if img_1 != blank %}
              {{
                img_1
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'cat-feature-card__img is-active',
                  data-image-index: '0',
                  alt: label_1
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'cat-feature-card__placeholder is-active' }}
            {% endif %}

            {% if img_2 != blank %}
              {{
                img_2
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'cat-feature-card__img',
                  data-image-index: '1',
                  alt: label_2
              }}
            {% elsif label_2 != blank and img_1 != blank %}
              {{
                img_1
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'cat-feature-card__img',
                  data-image-index: '1',
                  alt: label_2
              }}
            {% endif %}

            {% if img_3 != blank %}
              {{
                img_3
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'cat-feature-card__img',
                  data-image-index: '2',
                  alt: label_3
              }}
            {% elsif label_3 != blank and img_1 != blank %}
              {{
                img_1
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  class: 'cat-feature-card__img',
                  data-image-index: '2',
                  alt: label_3
              }}
            {% endif %}
          </div>

          <!-- Bottom: Headline & Social Proof -->
          <div class="cat-feature-card__bottom">
            {% if block.settings.highlight_title != blank %}
              <h4 class="cat-feature-card__highlight-title">{{ block.settings.highlight_title }}</h4>
            {% endif %}

            <div class="cat-feature-card__metrics">
              {% if block.settings.stat_sold != blank %}
                <span class="cat-feature-card__metric">
                  <span class="cat-dot--green"></span>
                  {{ block.settings.stat_sold }}
                </span>
              {% endif %}

              {% if block.settings.stat_wishlisted != blank %}
                <span class="cat-feature-card__metric">
                  <svg class="cat-icon-heart" viewBox="0 0 24 24" width="13" height="13" fill="#E11D48">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                  {{ block.settings.stat_wishlisted }}
                </span>
              {% endif %}

              {% if block.settings.badge_trending != blank %}
                <span class="cat-feature-card__metric cat-feature-card__metric--trending">
                  <svg class="cat-icon-bolt" viewBox="0 0 24 24" width="13" height="13" fill="#EAB308">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                  {{ block.settings.badge_trending }}
                </span>
              {% endif %}
            </div>
          </div>

        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function() {
    function initCategoryFeatureCards() {
      const cards = document.querySelectorAll('[data-cat-card]');
      cards.forEach(card => {
        if (card.dataset.initialized === 'true') return;
        card.dataset.initialized = 'true';

        const pills = card.querySelectorAll('[data-pill-index]');
        const images = card.querySelectorAll('[data-image-index]');
        const cardLink = card.querySelector('[data-card-link]');
        const arrowBtn = card.querySelector('[data-arrow-btn]');
        const slideCount = parseInt(card.dataset.slideCount || pills.length, 10);
        const intervalSeconds = parseInt(card.dataset.interval || 4, 10);

        if (slideCount <= 1 || pills.length <= 1) return;

        let currentIndex = 0;
        let timer = null;
        let isHovered = false;

        function goToSlide(index) {
          currentIndex = index;

          // Highlight the active pill and un-highlight others
          pills.forEach((pill, i) => {
            if (i === currentIndex) {
              pill.classList.add('cat-feature-card__pill--highlight');
            } else {
              pill.classList.remove('cat-feature-card__pill--highlight');
            }
          });

          // Show corresponding image with smooth cross-fade
          images.forEach((img, i) => {
            if (i === currentIndex) {
              img.classList.add('is-active');
            } else {
              img.classList.remove('is-active');
            }
          });

          // Update destination link to active collection
          const activePill = pills[currentIndex];
          if (activePill && activePill.dataset.url) {
            const newUrl = activePill.dataset.url;
            if (cardLink) cardLink.setAttribute('href', newUrl);
            if (arrowBtn) arrowBtn.setAttribute('href', newUrl);
          }
        }

        function startAutoplay() {
          stopAutoplay();
          timer = setInterval(() => {
            if (!isHovered) {
              const nextIndex = (currentIndex + 1) % slideCount;
              goToSlide(nextIndex);
            }
          }, intervalSeconds * 1000);
        }

        function stopAutoplay() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        // Click / Mouseenter on pills
        pills.forEach((pill, i) => {
          pill.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(i);
            startAutoplay();
          });

          pill.addEventListener('mouseenter', () => {
            goToSlide(i);
          });
        });

        // Pause rotation while mouse hovers over card
        card.addEventListener('mouseenter', () => {
          isHovered = true;
        });

        card.addEventListener('mouseleave', () => {
          isHovered = false;
        });

        startAutoplay();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategoryFeatureCards);
    } else {
      initCategoryFeatureCards();
    }

    document.addEventListener('shopify:section:load', initCategoryFeatureCards);
  })();
</script>

{% schema %}
{
  "name": "Category Feature Cards",
  "tag": "section",
  "class": "section-category-feature-cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Department"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated lifestyle and fashion collections"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAF7F2"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Auto-rotate interval (seconds)",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "header",
          "content": "Card Overview"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Heading",
          "default": "Clothing"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card Subtitle / Tagline",
          "default": "Signature Embroidered Luxury"
        },
        {
          "type": "header",
          "content": "Collection Tag 1"
        },
        {
          "type": "collection",
          "id": "collection_1",
          "label": "Select Collection 1"
        },
        {
          "type": "text",
          "id": "pill_1",
          "label": "Tag 1 Label",
          "default": "Pure Lawn",
          "info": "Leave blank to use Collection 1 title"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1 Override (optional)",
          "info": "Leave blank to use Collection 1 image or first product image"
        },
        {
          "type": "header",
          "content": "Collection Tag 2"
        },
        {
          "type": "collection",
          "id": "collection_2",
          "label": "Select Collection 2"
        },
        {
          "type": "text",
          "id": "pill_2",
          "label": "Tag 2 Label",
          "default": "Stitched 2 & 3pc",
          "info": "Leave blank to use Collection 2 title"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2 Override (optional)",
          "info": "Leave blank to use Collection 2 image or first product image"
        },
        {
          "type": "header",
          "content": "Collection Tag 3"
        },
        {
          "type": "collection",
          "id": "collection_3",
          "label": "Select Collection 3"
        },
        {
          "type": "text",
          "id": "pill_3",
          "label": "Tag 3 Label",
          "default": "Asim Jofa & More",
          "info": "Leave blank to use Collection 3 title"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3 Override (optional)",
          "info": "Leave blank to use Collection 3 image or first product image"
        },
        {
          "type": "header",
          "content": "Bottom Highlights & Metrics"
        },
        {
          "type": "text",
          "id": "highlight_title",
          "label": "Bottom Highlight Title",
          "default": "Bestselling Collection"
        },
        {
          "type": "text",
          "id": "stat_sold",
          "label": "Sold Metric",
          "default": "8.5k+ sold"
        },
        {
          "type": "text",
          "id": "stat_wishlisted",
          "label": "Wishlisted Metric",
          "default": "4.2k+ wishlisted"
        },
        {
          "type": "text",
